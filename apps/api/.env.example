# --- Núcleo ---
# development | production (en producción SECRET_KEY es obligatoria, >= 32 caracteres)
ENVIRONMENT=development
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Base de la app (usuarios, pagos). Por defecto: DATABASE_URL o SQLite en data/app.db
APP_DATABASE_URL=
AUTO_MIGRATE=true
# true solo detrás de un proxy de confianza (nginx, Render, Railway...)
TRUST_PROXY_HEADERS=false

# --- Base de datos (opcional: sin ella la API usa el CSV histórico) ---
# Usa DATABASE_URL o las variables DB_* (DATABASE_URL tiene prioridad).
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Asistente (opcional: sin clave responde con reglas locales) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- PayPal (opcional: sin credenciales los pagos responden 503) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Web ---
FRONTEND_URL=http://localhost:5174
# Lista separada por comas; por defecto FRONTEND_URL + localhost:5173/5174
CORS_ORIGINS=

# --- Admin (habilita POST /api/admin/scraping con cabecera X-Admin-Token) ---
ADMIN_TOKEN=

# --- Rutas de datos (opcionales; relativas a la raíz del repo) ---
RESULTADOS_CSV=
LOTO_CSV=
SUPERKINO_CSV=
