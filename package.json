{
  "name": "predictions-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para resultados, analitica y predicciones de loterias dominicanas.",
  "scripts": {
    "api:dev": "cd apps/api && python -m uvicorn app.main:app --reload --port 8000",
    "api:install": "python -m pip install -r requirements-dev.txt",
    "build": "npm run web:build",
    "check": "npm run lint && npm run test && npm run build",
    "dev": "npm run web:dev",
    "lint": "ruff check . && npm --workspace apps/web run lint",
    "loto:all": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 loto-all",
    "loto:predict": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 loto-predict",
    "loto:predict:py": "python packages/games/loto/predictor.py --csv data/loto/loto_historico.csv",
    "loto:update": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 loto-update",
    "loto:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 loto-watch",
    "repo:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 doctor",
    "repo:status": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 status",
    "start": "npm --workspace apps/web run start",
    "superkino:all": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 superkino-all",
    "superkino:predict": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 superkino-predict",
    "superkino:predict:py": "python packages/games/superkino/predictor.py --csv data/superkino/superkino_historico.csv",
    "superkino:update": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 superkino-update",
    "superkino:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/monorepo.ps1 superkino-watch",
    "test": "python -m pytest",
    "web:build": "npm --workspace apps/web run build",
    "web:dev": "npm --workspace apps/web run dev",
    "web:install": "npm --workspace apps/web install",
    "web:lint": "npm --workspace apps/web run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web"
  ]
}
