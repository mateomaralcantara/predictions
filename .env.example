# ════════════════════════════════════════════════════════════════════
#  Predictions RD · configuración local
#
#  1. Copia este archivo a  .env.local  (o ejecuta:  npm run setup)
#  2. Rellena solo lo que vayas a usar: TODO es opcional en desarrollo.
#  3. .env.local NO se sube a Git. Nunca pegues claves en el código.
#
#  Lo leen la API (apps/api) y la web (apps/web). En la web solo llegan
#  al navegador las variables que empiezan por VITE_ (nunca pongas
#  secretos con ese prefijo).
#  Comprueba la configuración con:  npm run doctor
# ════════════════════════════════════════════════════════════════════

# ── Núcleo ──────────────────────────────────────────────────────────
# development | production (en producción SECRET_KEY es obligatoria)
ENVIRONMENT=development
# Firma las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Inteligencia artificial (asistente) ─────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
# Si hay clave de Gemini se usa Gemini; si no, OpenAI; si no, reglas locales.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Supabase (PostgreSQL gestionado) ────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Recomendado: "Session pooler" (puerto 5432). También funciona el
# "Transaction pooler" (puerto 6543) y la conexión directa.
# Con esto, cuentas, pagos e histórico viven en Supabase.
SUPABASE_DB_URL=
# Claves de API (Project Settings → API Keys). Hoy no las usa la app
# (npm run doctor comprueba que Supabase las acepte);
# se reservan para Storage/Auth de Supabase. NO son la base de datos:
# para eso es SUPABASE_DB_URL (botón "Connect" → Session pooler).
# La secret (sb_secret_…) es SECRETA: nunca con prefijo VITE_.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# SUPABASE_SECRET_KEY=sb_secret_…

# ── Otra base de datos PostgreSQL (alternativa a Supabase) ──────────
# DATABASE_URL tiene prioridad sobre SUPABASE_DB_URL y sobre DB_*.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/loterias_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=loterias_db
# DB_USER=postgres
# DB_PASSWORD=

# ── Pagos con PayPal ────────────────────────────────────────────────
# https://developer.paypal.com/dashboard/applications
# Sandbox: https://api-m.sandbox.paypal.com · Real: https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── Web ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
# Orígenes permitidos (coma). Por defecto FRONTEND_URL + localhost.
# CORS_ORIGINS=
# Solo si la API está en otro dominio (producción sin proxy):
# VITE_API_URL=https://api.tudominio.com
# Destino del proxy de desarrollo de Vite:
# API_PROXY_TARGET=http://127.0.0.1:8000

# ── Actualización automática de sorteos ─────────────────────────────
# Mientras la API está encendida descarga los sorteos nuevos de todas las
# loterías (labanca.do) y los guarda en data/vivo/ y en la base de datos.
AUTO_ACTUALIZAR=true
ACTUALIZAR_CADA_MIN=30

# ── Administración ──────────────────────────────────────────────────
# Habilita POST /api/admin/* con la cabecera X-Admin-Token.
ADMIN_TOKEN=
